# sr-lab telemetry export configuration
# Copy this file to .env (same folder) and fill in your values.
# .env is gitignored at every level — these values never enter version control.

# Prometheus-compatible API base URL
PROM_URL=http://your-prometheus:9090

# Three queries — wrap each in sum(...) so it returns ONE series.
# Rate: arrivals per second for one busy service
RATE_QUERY=sum(rate(http_requests_total{job="yourservice"}[5m]))

# Latency: average seconds (or ms — auto-detected) per request
LATENCY_QUERY=sum(rate(http_request_duration_seconds_sum{job="yourservice"}[5m]))/sum(rate(http_request_duration_seconds_count{job="yourservice"}[5m]))

# In-flight: concurrent requests in the system
INFLIGHT_QUERY=sum(http_requests_in_flight{job="yourservice"})

# Optional auth for hosted Prometheus APIs (Fly.io, Grafana Cloud, ...).
# Leave both unset for an unauthenticated local Prometheus.
#   PROM_TOKEN       -> sends "Authorization: Bearer <token>"
#   PROM_AUTH_HEADER -> sent verbatim, wins over PROM_TOKEN (e.g. FlyV1 fm2_...)
#PROM_TOKEN=
#PROM_AUTH_HEADER=

# Fly.io example (managed Prometheus — proxy metrics need no app changes):
#   PROM_URL=https://api.fly.io/prometheus/YOUR-ORG-SLUG
#   RATE_QUERY=sum(rate(fly_app_http_responses_count{app="YOURAPP"}[5m]))
#   LATENCY_QUERY=sum(rate(fly_app_http_response_time_seconds_sum{app="YOURAPP"}[5m]))/sum(rate(fly_app_http_response_time_seconds_count{app="YOURAPP"}[5m]))
#   INFLIGHT_QUERY=sum(fly_app_concurrency{app="YOURAPP"})
#   PROM_AUTH_HEADER=<paste the FULL output of: fly tokens create readonly — it already starts with "FlyV1 ">

# Optional (defaults shown)
#DAYS=7
#STEP_SECONDS=60
#OUT_FILE=backend\data\private\service_telemetry.csv
